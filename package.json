{
  "name": "chemdatadoctor-mcp",
  "version": "0.1.0",
  "description": "Local, offline chemical data cleaning tools over MCP stdio",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "chemdatadoctor-mcp": "dist/cli.js"
  },
  "exports": "./dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third-party-licenses",
    "docs",
    "examples"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chemaiatlas/chemdatadoctor-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "schemas": "npm run build && node scripts/export-schemas.mjs",
    "licenses": "node scripts/licenses.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "prepack": "npm run build && npm run check:release"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "papaparse": "5.5.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@types/papaparse": "5.3.16",
    "typescript": "5.9.3"
  }
}
