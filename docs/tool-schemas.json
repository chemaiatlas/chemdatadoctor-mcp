    {
      "name": "clean_dataset",
      "description": "Clean a local CSV/TSV/XLS/XLSX/JSON file or small inline row array. Explicit zero-based column mapping. Writes new local artifacts; preserves source and originals. Default summary only.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "object",
                "properties": {
                  "totalRows": {
                    "type": "integer"
                  },
                  "changedRows": {
                    "type": "integer"
                  },
                  "duplicateRows": {
                    "type": "integer"
                  },
                  "findings": {
                    "type": "object",
                    "properties": {
                      "error": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "warning": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "automatic_fix": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "unverifiable": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "error",
                      "warning",
                      "automatic_fix",
                      "unverifiable"
                    ],
                    "additionalProperties": false
                  },
                  "rowsByCategory": {
                    "$ref": "#/properties/data/properties/summary/properties/findings"
                  },
                  "issuesByCode": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer"
                    }
                  }
                },
                "required": [
                  "totalRows",
                  "changedRows",
                  "duplicateRows",
                  "findings",
                  "rowsByCategory",
                  "issuesByCode"
                ],
                "additionalProperties": false
              },
              "artifacts": {
                "type": "object",
                "properties": {
                  "results": {
                    "type": "string"
                  },
                  "report": {
                    "type": "string"
                  },
                  "csv": {
                    "type": "string"
                  },
                  "excel": {
                    "type": "string"
                  }
                },
                "required": [
                  "results",
                  "report",
                  "csv",
                  "excel"
                ],
                "additionalProperties": false
              },
              "samples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceRow": {
                      "type": "integer"
                    },
                    "casStatus": {
                      "type": "string"
                    },
                    "issueCodes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "duplicateOf": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "sourceRow",
                    "casStatus",
                    "issueCodes"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "summary",
              "artifacts",
              "samples"
            ],
            "additionalProperties": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
